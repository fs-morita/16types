---
import { PR_LABEL, AFFILIATE_DISCLOSURE, AMAZON_ATTRIBUTION } from '../consts';

/**
 * ステマ規制（景品表示法・2023年10月施行）対応の広告表示。
 *
 * 「記事のどこかに書く」では要件を満たさない。冒頭など視認性の高い位置に
 * 明示する必要があるため、PostLayout の本文より前に固定配置している。
 * 個別記事側で出し分けできないようにしてあるのは意図的。
 */
---

<aside class="disclosure">
  <span class="pr">{PR_LABEL}</span>
  <p>
    {AFFILIATE_DISCLOSURE}
    <span class="attribution">{AMAZON_ATTRIBUTION}</span>
  </p>
</aside>

<style>
  .disclosure {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin: 0 0 2.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-alt);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .pr {
    flex: none;
    padding: 0.08rem 0.5rem;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .disclosure p {
    margin: 0;
    color: var(--fg-muted);
  }

  .attribution {
    display: block;
    color: var(--fg-faint);
  }
</style>
