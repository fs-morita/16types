---
interface Props {
  /** 見出し行。1列目は商品名・項目名を想定。 */
  headers: string[];
  /** 各行。headers と同じ列数にすること。 */
  rows: string[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;

const bad = rows.find((r) => r.length !== headers.length);
if (bad) {
  throw new Error(
    `ComparisonTable: 列数が見出しと一致しません（見出し ${headers.length} 列 / 行 ${bad.length} 列）: ${bad.join(' | ')}`
  );
}
---

{/* 表だけを横スクロールさせる。ページ本体は横に溢れさせない（global.css の .scroll-x） */}
<div class="scroll-x">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* 比較表は語句が短いので折り返さない。長い説明が入る場合は td 側で解除する */
  thead th {
    white-space: nowrap;
  }

  tbody th {
    white-space: nowrap;
  }
</style>
