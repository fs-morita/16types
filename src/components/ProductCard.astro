---
import { getProduct } from '../data/products';
import { amazonLink } from '../lib/amazon';

interface Props {
  /** products.ts の商品ID。存在しなければビルドが落ちる。 */
  id: string;
}

const { id } = Astro.props;

const product = getProduct(id);
const { name, whatItIs, priceHint } = product;

// タグ付けを一箇所に集約する。未設定ならここでビルドが落ちる
const href = amazonLink(product.asin);
---

{/*
  カードは「商品名・それが何か・リンク」だけに絞っている。
  なぜそのタイプに向くのかは、記事本文の指標分解セクションで説明する。
  カード側で理由を繰り返すと冗長になるため、意図的に置いていない。
*/}
<div class="card">
  <div class="head">
    <h3>{name}</h3>
    {priceHint && <span class="price">{priceHint}</span>}
  </div>

  {/* 画像が使えないぶん、それが何なのかを言葉で補う */}
  <p class="what">{whatItIs}</p>

  <a class="buy" href={href} target="_blank" rel="nofollow sponsored noopener">
    Amazonで見る
  </a>
</div>

<style>
  .card {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    align-items: baseline;
    width: 100%;
  }

  .head h3 {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .price {
    color: var(--fg-muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .what {
    flex: 1 1 14rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.75;
  }

  .buy {
    flex: none;
    padding: 0.5rem 1.3rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .buy:hover {
    color: var(--accent-fg);
    opacity: 0.88;
  }
</style>
