---
import { AXIS_GUIDANCE } from '../data/mbti-types';
import { amazonLink } from '../lib/amazon';

interface Props {
  name: string;
  /**
   * ASIN（英数10桁）または amazon.co.jp の商品URL。
   * アソシエイトタグは amazonLink() が自動で付けるので、記事側では書かない。
   */
  url: string;
  price?: string;
  /**
   * なぜこのタイプに合うのか。
   * 「INTJだからこれ」ではなく、指標に翻訳した理由を書く。
   */
  reason: string;
  /** 根拠にした指標（例: ['I', 'N']）。reason の裏づけとして表示する。 */
  axes?: string[];
  /**
   * 気になる点。必須。
   *
   * 良い点しか書かれていない商品紹介は信用を失うため、
   * 省略できないプロパティにしてある。合わない場面を必ず書くこと。
   */
  cons: string;
}

const { name, url, price, reason, axes = [], cons } = Astro.props;

// タグ付けを一箇所に集約する。未設定ならここでビルドが落ちる
const href = amazonLink(url);
---

<div class="card">
  <div class="head">
    <h3>{name}</h3>
    {price && <span class="price">{price}</span>}
  </div>

  {
    axes.length > 0 && (
      <ul class="axes">
        {axes.map((a) => (
          <li>
            <b>{a}</b>
            <span>{AXIS_GUIDANCE[a]?.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  <p class="reason">{reason}</p>

  <div class="cons">
    <p class="cons-label">気になる点</p>
    <p class="cons-body">{cons}</p>
  </div>

  <a class="buy" href={href} target="_blank" rel="nofollow sponsored noopener">
    Amazonで見る
  </a>
</div>

<style>
  .card {
    margin: 1.75rem 0;
    padding: 1.15rem 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .head h3 {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .price {
    flex: none;
    color: var(--fg-muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .axes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .axes li {
    display: inline-flex;
    gap: 0.35rem;
    align-items: baseline;
    margin: 0;
    padding: 0.12rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .axes b {
    letter-spacing: 0.06em;
  }

  .axes span {
    color: var(--fg-muted);
  }

  .reason {
    margin: 0.9rem 0 0;
    line-height: 1.95;
  }

  .cons {
    margin-top: 1rem;
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    background: var(--surface-alt);
  }

  .cons-label {
    margin: 0 0 0.15rem;
    color: var(--fg-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .cons-body {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.85;
  }

  .buy {
    display: inline-block;
    margin-top: 1.2rem;
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }

  .buy:hover {
    color: var(--accent-fg);
    opacity: 0.88;
  }
</style>
