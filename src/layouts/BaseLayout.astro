---
import '../styles/global.css';
import { SITE_TITLE, SITE_TAGLINE, AMAZON_ATTRIBUTION } from '../consts';

interface Props {
  title: string;
  description: string;
  /** トップページなど、タイトルにサイト名を重ねたくないページで true。 */
  isRoot?: boolean;
  /** 本文幅ではなく広い幅を使うページ（一覧など）で true。 */
  wide?: boolean;
  /** OG画像のパス。未指定ならサイト共通のものを使う。 */
  ogImage?: string;
}

const {
  title,
  description,
  isRoot = false,
  wide = false,
  ogImage = '/og-default.png',
} = Astro.props;

const pageTitle = isRoot ? `${SITE_TITLE} | ${SITE_TAGLINE}` : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#2f4858" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15161a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={isRoot ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap-wide bar">
        <a class="brand" href="/">
          <span class="brand-name">{SITE_TITLE}</span>
          <span class="brand-tag">{SITE_TAGLINE}</span>
        </a>
        <nav aria-label="メイン">
          <a href="/">タイプ一覧</a>
          <a href="/about/">運営者情報</a>
        </nav>
      </div>
    </header>

    <main id="main" class={wide ? 'wrap-wide' : 'wrap'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap-wide">
        <nav aria-label="フッター">
          <a href="/">タイプ一覧</a>
          <a href="/about/">運営者情報</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/disclaimer/">免責事項</a>
        </nav>
        {/*
          Amazonアソシエイト運営規約が求める帰属表示。
          「サイトに目立つように明示」が要件で、記事冒頭である必要はないため
          全ページ共通のフッターに置いている。削除しないこと。
        */}
        <p class="attribution">{AMAZON_ATTRIBUTION}</p>
        <p class="copy">&copy; {year} {SITE_TITLE}</p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10;
        padding: 0.6rem 1rem;
        background: var(--accent);
        color: var(--accent-fg);
        text-decoration: none;
      }

      .skip:focus {
        left: 0;
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }

      .bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 0.9rem;
      }

      .brand {
        color: inherit;
        text-decoration: none;
        line-height: 1.4;
      }

      .brand-name {
        display: block;
        font-size: var(--step-1);
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .brand-tag {
        display: block;
        margin-top: 0.15rem;
        color: var(--fg-muted);
        font-size: var(--step--1);
        line-height: 1.5;
      }

      /* スマホではタグラインが2行になって嵩張るので隠す */
      @media (max-width: 30rem) {
        .brand-tag {
          display: none;
        }
      }

      .site-header nav,
      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.4rem;
        font-size: var(--step--1);
      }

      .site-header nav a {
        color: var(--fg-muted);
        text-decoration: none;
        white-space: nowrap;
      }

      .site-header nav a:hover {
        color: var(--link);
        text-decoration: underline;
      }

      .site-footer {
        margin-top: 4rem;
        padding-block: 2rem 3rem;
        border-top: 1px solid var(--border);
        background: var(--surface);
        color: var(--fg-muted);
        font-size: var(--step--1);
      }

      .attribution {
        margin: 1.25rem 0 0;
        line-height: 1.7;
      }

      .copy {
        margin: 0.75rem 0 0;
        color: var(--fg-faint);
      }
    </style>
  </body>
</html>
