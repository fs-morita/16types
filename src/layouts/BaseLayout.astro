---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** トップページなど、タイトルにサイト名を重ねたくないページで true。 */
  isRoot?: boolean;
}

const { title, description, isRoot = false } = Astro.props;

const pageTitle = isRoot ? `${SITE_TITLE} | ${SITE_TAGLINE}` : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <strong>{SITE_TITLE}</strong>
        <span>{SITE_TAGLINE}</span>
      </a>
      <nav>
        <a href="/">タイプ一覧</a>
        <a href="/about/">運営者情報</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav>
        <a href="/about/">運営者情報</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/disclaimer/">免責事項</a>
      </nav>
      <p>&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1c1c1e;
        --fg-muted: #6b6b73;
        --border: #e3e3e8;
        --surface: #fafafc;
        --surface-alt: #f2f2f5;
        --accent: #2f4858;
        --accent-fg: #ffffff;
        --link: #1f5f8b;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16161a;
          --fg: #e8e8ea;
          --fg-muted: #9a9aa3;
          --border: #2e2e35;
          --surface: #1e1e23;
          --surface-alt: #26262c;
          --accent: #7aa6c2;
          --accent-fg: #10161b;
          --link: #8fc0e0;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans',
          'Noto Sans JP', 'Yu Gothic', Meiryo, sans-serif;
        line-height: 1.9;
        /* 表やコードは各自で横スクロールさせ、ページ本体は横に溢れさせない */
        overflow-x: hidden;
      }

      main {
        max-width: 44rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }

      a {
        color: var(--link);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      h1 {
        font-size: 1.7rem;
        line-height: 1.5;
      }

      h2 {
        margin-top: 2.75rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--border);
        font-size: 1.3rem;
        line-height: 1.6;
      }

      h3 {
        margin-top: 2rem;
        font-size: 1.1rem;
        line-height: 1.6;
      }

      .site-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        max-width: 44rem;
        margin: 0 auto;
        padding: 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .brand {
        color: inherit;
        text-decoration: none;
      }

      .brand strong {
        display: block;
        font-size: 1.05rem;
      }

      .brand span {
        display: block;
        color: var(--fg-muted);
        font-size: 0.78rem;
        line-height: 1.6;
      }

      .site-header nav,
      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.85rem;
      }

      .site-footer {
        max-width: 44rem;
        margin: 0 auto;
        padding: 1.75rem 1.25rem 3rem;
        border-top: 1px solid var(--border);
        color: var(--fg-muted);
        font-size: 0.85rem;
      }

      .site-footer p {
        margin: 1rem 0 0;
      }
    </style>
  </body>
</html>
