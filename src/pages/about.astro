---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_TITLE,
  AUTHOR_TYPE,
  AMAZON_ATTRIBUTION,
  DIAGNOSIS_NOTICE,
} from '../consts';
import { getType, typeLabel } from '../data/mbti-types';

const author = getType(AUTHOR_TYPE);
---

<BaseLayout
  title="運営者情報"
  description={`${SITE_TITLE}の運営方針と運営者について。`}
>
  <h1>運営者情報</h1>

  <h2>運営者</h2>
  <p>
    {author ? typeLabel(author) : AUTHOR_TYPE}。
    {/* TODO: 表示名・自己紹介を記入する。連絡先メールアドレスを公開するかは要検討。 */}
  </p>

  <h2>このサイトの方針</h2>
  <ul>
    <li>
      性格タイプと商品を「タイプ名」で直接結びつけません。4つの指標
      （外向/内向・直観/感覚・思考/感情・判断/知覚）に翻訳した理由を必ず書きます。
    </li>
    <li>
      良い点だけを書きません。合わない場面と気になる点を必ず併記します。
    </li>
    <li>
      他サイトの説明文やイラストを転載しません。文章はすべて自分で書いています。
    </li>
  </ul>

  <h2>広告について</h2>
  <p>{AMAZON_ATTRIBUTION}</p>
  <p>
    アフィリエイト広告を含む記事には、冒頭に「PR」と明示しています。
  </p>

  <h2>取り扱う診断について</h2>
  <p>{DIAGNOSIS_NOTICE}</p>

  <h2>お問い合わせ</h2>
  <p>
    {/* TODO: 連絡先（メールフォーム or メールアドレス）を記入する。
        Amazonアソシエイトの審査でも連絡手段があると望ましい。 */}
    準備中です。
  </p>
</BaseLayout>
